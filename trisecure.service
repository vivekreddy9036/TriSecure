[Unit]
Description=TRIsecure - Secure eVoting System
Documentation=https://trisecure.dev
After=network-online.target
Wants=network-online.target

[Service]
Type=notify
User=trisecure
Group=trisecure
WorkingDirectory=/opt/trisecure
Environment="PYTHONUNBUFFERED=1"
Environment="TRISECURE_MODE=production"
Environment="TRISECURE_LOG_FILE=/var/log/trisecure/trisecure.log"
Environment="TRISECURE_DATABASE_PATH=/var/lib/trisecure/trisecure.db"

# Load secrets from a protected file (chmod 640, owned root:trisecure)
EnvironmentFile=/etc/trisecure/secrets.env

# Hardware access (i2c=PN532, spi=NFC SPI bus, video=webcam, gpio=GPIO pins)
SupplementaryGroups=i2c spi video gpio

# Restart policy
Restart=on-failure
RestartSec=5s
StartLimitInterval=60s
StartLimitBurst=3

# Watchdog — systemd will restart if app hangs for >120s without notifying
WatchdogSec=120s
NotifyAccess=main

# Resource limits
MemoryMax=512M
CPUQuota=80%

# Security hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/trisecure /var/log/trisecure

# Startup
ExecStart=/opt/trisecure/venv/bin/python app.py

# Graceful shutdown
KillMode=process
KillSignal=SIGTERM
TimeoutStopSec=10s

[Install]
WantedBy=multi-user.target

